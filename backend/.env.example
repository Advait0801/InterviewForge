BACKEND_PORT=4000
# Must match .env.postgres; "postgres" is the compose service name.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/interviewforge
# Required, >= 32 chars; the backend refuses to start otherwise (D-053).
# Generate one with: openssl rand -hex 32
JWT_SECRET=
CODE_RUNNER_URL=http://code-runner:5000
AI_SERVICE_URL=http://ai-service:8000
FRONTEND_URL=http://localhost:3002
BACKEND_PUBLIC_URL=http://localhost:4000
# Behind a reverse proxy (Nginx in prod), set to the number of proxy hops so rate
# limits see the client's IP. Leave unset when clients connect directly.
# TRUST_PROXY=1
# Optional rate-limit overrides (defaults shown):
# API_RATE_LIMIT_MAX=500
# LLM_RATE_LIMIT_MAX=40
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_WRITE_RATE_LIMIT_MAX=20

# Dev only: log responses that break backend/openapi/openapi.yaml as openapi_violation (D-062).
# Never set in production.
# OPENAPI_VALIDATE_RESPONSES=1

# Redis (D-063): shared rate limits, the code-run queue, the leaderboard cache.
# Unset = in-memory limits, no queue, no cache (unit tests). Set but unreachable = code runs 503.
REDIS_URL=redis://redis:6379
# Max sandbox containers at once, across every backend instance.
CODE_RUN_CONCURRENCY=4
# Queue wait plus execution before a run gives up with a retryable 503.
CODE_RUN_QUEUE_TIMEOUT_MS=90000

# Interviewer upgrades (D-066)
# Seconds a candidate must be stuck on a question (or since the previous hint) before the
# next hint unlocks.
HINT_UNLOCK_SECONDS=30
# Grounded challenge: push back when an answer contradicts the retrieved context. Off until
# the interview UI shows it (UI B); costs up to two extra model calls per first answer.
INTERVIEW_CHALLENGE_ENABLED=false

# Agentic interviewer (D-067)
# Default mode for new interviews: fixed (the original loop) or agent. A start request's
# `mode` overrides it. Stays fixed until the interview UI shows agent moves (UI B).
INTERVIEW_MODE=fixed
# Estimated model spend (USD) per interview after which the agent is no longer consulted;
# the interview continues on the fixed rules.
INTERVIEW_COST_CAP_USD=0.02
