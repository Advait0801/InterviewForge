BACKEND_PORT=4000
# Must match .env.postgres; "postgres" is the compose service name.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/interviewforge
# Required, >= 32 chars; the backend refuses to start otherwise (D-053).
# Generate one with: openssl rand -hex 32
JWT_SECRET=
CODE_RUNNER_URL=http://code-runner:5000
AI_SERVICE_URL=http://ai-service:8000
FRONTEND_URL=http://localhost:3002
BACKEND_PUBLIC_URL=http://localhost:4000
# Behind a reverse proxy (Nginx in prod), set to the number of proxy hops so rate
# limits see the client's IP. Leave unset when clients connect directly.
# TRUST_PROXY=1
# Optional rate-limit overrides (defaults shown):
# API_RATE_LIMIT_MAX=500
# LLM_RATE_LIMIT_MAX=40
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_WRITE_RATE_LIMIT_MAX=20
