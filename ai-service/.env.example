AI_SERVICE_PORT=8000
# At least one provider key is required; both enables fallback (Gemini -> OpenAI).
GEMINI_API_KEY=
# Also used for embeddings (EMBEDDING_PROVIDER=openai below).
OPENAI_API_KEY=
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=interviewforge_docs
RAG_TOP_K=5
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
GEMINI_MODEL=gemini-3.1-flash-lite-preview
OPENAI_MODEL=gpt-4o-mini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER_ORDER=gemini,openai
# OpenAI for bulk-ingestion throughput (D-016). Changing the provider or model
# means rebuilding the Chroma collection.
EMBEDDING_PROVIDER=openai
