AI_SERVICE_PORT=8000
# At least one provider key is required; both enables fallback (Gemini -> OpenAI).
GEMINI_API_KEY=
# Also used for embeddings (EMBEDDING_PROVIDER=openai below).
OPENAI_API_KEY=
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=interviewforge_docs
RAG_TOP_K=5
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
GEMINI_MODEL=gemini-3.1-flash-lite-preview
OPENAI_MODEL=gpt-4o-mini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER_ORDER=gemini,openai
# OpenAI for bulk-ingestion throughput (D-016). Changing the provider or model
# means rebuilding the Chroma collection.
EMBEDDING_PROVIDER=openai

# Redis (D-063): shares the live-fetch limits across workers and instances (F-19).
# Unset = in-process counters (single process only). Set but unreachable = live fetch denied.
REDIS_URL=redis://redis:6379

# Retrieval cache (Phase 11). Shares REDIS_URL; unset = in-process, unreachable = bypassed.
# Bounded because Redis runs noeviction: at most RAG_CACHE_MAX_ENTRIES results of at most
# RAG_CACHE_MAX_ENTRY_BYTES each, every key with a TTL. Any corpus write invalidates it.
RAG_CACHE_ENABLED=true
# Semantic tier: reranked routes only, calibrated at 0.80 (docs/eval/phase11.md). Off: on today's
# traffic it would only merge an interview's difficulty variants (cosine 0.94-0.98).
RAG_CACHE_SEMANTIC_ENABLED=false
RAG_CACHE_SEMANTIC_THRESHOLD=0.80
RAG_CACHE_TTL_SECONDS=21600
# A result whose reranker timed out is first-stage order: kept this long only.
RAG_CACHE_DEGRADED_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=200
RAG_CACHE_MAX_ENTRY_BYTES=65536
RAG_CACHE_PARTITION_MAX=64
